# Khi ban cai integration "Neon" tu Vercel Marketplace, Vercel se tu dong dien bien nay.
# Chi can dien tay neu ban chay du an o may local (lay tu Neon console hoac lenh "vercel env pull").
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Ban PHAI tu dat bien nay trong Vercel dashboard (Settings > Environment Variables).
# Day la chuoi bi mat dung de ky token dang nhap - hay dung mot chuoi ngau nhien, dai, kho doan.
JWT_SECRET="doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu"
